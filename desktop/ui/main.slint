import { Theme } from "theme.slint";
import { EmptyState } from "components/empty_state.slint";
import { Toolbar } from "components/toolbar.slint";
import { MenuRow } from "components/toolbar.slint";
import { FloatingControls } from "components/floating_controls.slint";
import { InfoSidebar } from "components/info_sidebar.slint";

export component MainWindow inherits Window {
    title: root.current-filename == "" ? "Veyra" : root.current-filename;
    icon: @image-url("../../assets/logo/logo.png");
    preferred-width: 680px; preferred-height: 460px; min-width: 640px; min-height: 420px;
    background: Theme.canvas; default-font-size: 13px;
    in property <[string]> files: []; in property <int> current-index: -1; in property <string> status-text: "";
    in-out property <float> zoom: 1.0; in property <int> rotation: 0; in property <image> current-image; in property <bool> has-image: false; in property <string> error-text: ""; in property <string> current-filename: ""; in property <string> image-dimensions: "";
    in property <string> metadata-folder: ""; in property <string> metadata-format: ""; in property <string> metadata-file-size: ""; in property <string> metadata-created: ""; in property <string> metadata-modified: "";
    in-out property <bool> is-fullscreen: false; in-out property <bool> show-properties: false; in-out property <bool> show-menu: false; in-out property <bool> zoom-menu-open: false; in-out property <float> pan-x: 0; in-out property <float> pan-y: 0;
    callback open-folder(); callback open-file(); callback zoom-in(); callback zoom-out(); callback fit-window(); callback actual-size(); callback rotate-left(); callback rotate-right(); callback prev-image(); callback next-image(); callback toggle-fullscreen(); callback new-window(); callback quit-app(); callback set-wallpaper(); callback select-file(int);
    property <float> img-w: root.current-image.width * 1.0; property <float> img-h: root.current-image.height * 1.0; property <float> vw: viewer.width / 1px; property <float> vh: viewer.height / 1px;
    property <float> fit-scale: img-w > 0 && img-h > 0 && vw > 0 && vh > 0 ? min(vw / img-w, vh / img-h) : 1.0; property <float> rendered-w: img-w * fit-scale * root.zoom; property <float> rendered-h: img-h * fit-scale * root.zoom;
    property <float> max-pan-x: max(0, (rendered-w - vw) / 2); property <float> max-pan-y: max(0, (rendered-h - vh) / 2); property <float> clamped-pan-x: min(max(root.pan-x, -max-pan-x), max-pan-x); property <float> clamped-pan-y: min(max(root.pan-y, -max-pan-y), max-pan-y);

    FocusScope { width: 0px; height: 0px; key-pressed(event) => {
        if (event.text == Key.Escape) { if (root.show-properties) { root.show-properties = false; return accept; } if (root.is-fullscreen) { root.toggle-fullscreen(); return accept; } }
        if (event.text == Key.LeftArrow) { root.prev-image(); return accept; } if (event.text == Key.RightArrow) { root.next-image(); return accept; }
        if (event.text == "+" || event.text == "=") { root.zoom-in(); return accept; } if (event.text == "-") { root.zoom-out(); return accept; }
        if (event.text == "f" || event.text == "F" || event.text == Key.F11) { root.toggle-fullscreen(); return accept; } reject
    } }

    VerticalLayout { spacing: 0;
        if root.has-image: Toolbar {
            show-info: root.show-properties; is-fullscreen: root.is-fullscreen;
            open-file => { root.open-file(); } open-folder => { root.open-folder(); }
            rotate-left => { root.rotate-left(); } rotate-right => { root.rotate-right(); } fullscreen => { root.toggle-fullscreen(); } info => { root.show-properties = !root.show-properties; } menu => { root.show-menu = !root.show-menu; }
            new-window => { root.new-window(); } quit => { root.quit-app(); } help => { } shortcuts => { } about => { }
        }
        HorizontalLayout { spacing: 0; vertical-stretch: 1;
            viewer := Rectangle { background: Theme.canvas; clip: true; horizontal-stretch: 1; vertical-stretch: 1;
                if root.has-image: Image { source: root.current-image; width: root.rendered-w * 1px; height: root.rendered-h * 1px; x: (parent.width - self.width) / 2 + root.clamped-pan-x * 1px; y: (parent.height - self.height) / 2 + root.clamped-pan-y * 1px; transform-rotation: root.rotation * 1deg; }
                if !root.has-image && root.error-text == "": EmptyState { open-folder => { root.open-folder(); } open-file => { root.open-file(); } }
                if !root.has-image && root.error-text != "": Text { text: root.error-text; color: #f66151; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                TouchArea { enabled: root.has-image; property <float> sx: 0; property <float> sy: 0; property <float> spx: 0; property <float> spy: 0;
                    pointer-event(event) => { if (event.kind == PointerEventKind.down && root.has-image && root.zoom > 1.01) { self.sx = self.mouse-x / 1px; self.sy = self.mouse-y / 1px; self.spx = root.pan-x; self.spy = root.pan-y; } }
                    moved => { if (self.pressed && root.has-image && root.zoom > 1.01) { root.pan-x = self.spx + (self.mouse-x / 1px - self.sx); root.pan-y = self.spy + (self.mouse-y / 1px - self.sy); } }
                    scroll-event(event) => { if (root.has-image) { if (event.delta-y > 0) { root.zoom-in(); } else if (event.delta-y < 0) { root.zoom-out(); } accept } reject }
                }
                if root.has-image: FloatingControls { has-previous: root.current-index > 0; has-next: root.current-index + 1 < root.files.length; zoom: root.zoom; prev => { root.prev-image(); } next => { root.next-image(); } zoom-in => { root.zoom-in(); } zoom-preset(value) => { if (value == 0) { root.fit-window(); } else { root.zoom = value; root.pan-x = 0; root.pan-y = 0; } } }
            }
            if root.show-properties: InfoSidebar { folder: root.metadata-folder; dimensions: root.image-dimensions; format: root.metadata-format; file-size: root.metadata-file-size; created: root.metadata-created; modified: root.metadata-modified; }
        }
    }
    if root.show-menu: Rectangle {
        x: root.width - 274px; y: 54px; width: 264px; height: 286px; z: 20;
        border-radius: 12px; background: #3a3a3a; border-width: 1px; border-color: #505050;
        VerticalLayout { padding: 8px; spacing: 2px;
            MenuRow { text: "New Window"; shortcut: "Ctrl+N"; clicked => { root.new-window(); root.show-menu = false; } }
            MenuRow { text: "Open..."; shortcut: "Ctrl+O"; clicked => { root.open-file(); root.show-menu = false; } }
            Rectangle { height: 1px; background: #555555; }
            MenuRow { text: "Rotate Left"; clicked => { root.rotate-left(); root.show-menu = false; } }
            MenuRow { text: "Rotate Right"; clicked => { root.rotate-right(); root.show-menu = false; } }
            Rectangle { height: 1px; background: #555555; }
            MenuRow { text: "Help"; shortcut: "F1"; clicked => { root.show-menu = false; } }
            MenuRow { text: "Keyboard Shortcuts"; shortcut: "Ctrl+?"; clicked => { root.show-menu = false; } }
            MenuRow { text: "About Veyra"; clicked => { root.show-menu = false; } }
            MenuRow { text: "Quit"; shortcut: "Ctrl+Q"; clicked => { root.quit-app(); root.show-menu = false; } }
        }
    }
}
