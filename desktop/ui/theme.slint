export global Theme {
    out property <color> canvas: #1e1e1e;
    out property <color> toolbar: #242424;
    out property <color> panel: #2c2c2e;
    out property <color> text: #f2f2f2;
    out property <color> secondary-text: #9a9a9e;
    out property <color> icon-muted: #8e8e93;
    out property <color> accent: #0a84ff;
    out property <length> toolbar-height: 44px;
    out property <length> control-size: 34px;
    out property <length> pill-radius: 999px;
}
