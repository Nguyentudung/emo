import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

export component ToolButton inherits Rectangle {
    in property <image> icon; in property <bool> enabled: true; in property <bool> active: false; in property <bool> frosted: false; callback clicked();
    width: Theme.control-size; height: Theme.control-size; border-radius: root.frosted ? 14px : 6px;
    background: !root.enabled ? transparent : (hit.pressed ? (root.frosted ? #ffffff2e : #4d4d4d) : (hit.has-hover ? (root.frosted ? #ffffff1f : #383838) : (root.active ? #404040 : transparent)));
    Image { source: root.icon; width: 18px; height: 18px; colorize: root.enabled ? #ffffff : #666666; horizontal-alignment: center; vertical-alignment: center; }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

export component MenuRow inherits Rectangle {
    in property <string> text; in property <string> shortcut: ""; in property <bool> enabled: true; callback clicked();
    height: 30px; border-radius: 6px; background: !root.enabled ? transparent : (hit.pressed ? #555555 : (hit.has-hover ? #484848 : transparent));
    Text { text: root.text; x: 10px; color: root.enabled ? #f2f2f2 : #888888; vertical-alignment: center; }
    Text { text: root.shortcut; x: parent.width - self.width - 10px; color: #b0b0b0; vertical-alignment: center; }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

export component Toolbar inherits Rectangle {
    callback open-file(); callback open-folder(); callback rotate-left(); callback rotate-right(); callback fullscreen(); callback info(); callback menu(); callback new-window(); callback quit(); callback help(); callback shortcuts(); callback about();
    in property <bool> show-info: false; in property <bool> is-fullscreen: false;
    height: 48px; background: Theme.toolbar;
    HorizontalLayout { y: (parent.height - 34px) / 2; height: 34px; padding-left: 10px; padding-right: 10px; spacing: 3px;
        ToolButton { icon: Icons.rotate-left; clicked => { root.rotate-left(); } }
        ToolButton { icon: Icons.rotate-right; clicked => { root.rotate-right(); } }
        ToolButton { icon: Icons.fullscreen; active: root.is-fullscreen; clicked => { root.fullscreen(); } }
        ToolButton { icon: Icons.info; active: root.show-info; clicked => { root.info(); } }
        Rectangle { horizontal-stretch: 1; }
        ToolButton { icon: Icons.menu; clicked => { root.menu(); } }
    }
}

